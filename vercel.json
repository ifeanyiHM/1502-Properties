{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/blog/[slug].js": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/api/blog/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
